{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Blog post json schema",
    "description": "A schema outlining options for a single blog post",
    "type": "object",
    "required": [ "posts" ],
    "properties": {
        "posts": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [ "title", "date", "size" ],
                "properties": {
                    "title": {
                        "description": "Title of the blog post",
                        "type": "string"
                    },
                    "date": {
                        "description": "Date the post was made",
                        "type": "string",
                        "pattern": "^\\d{1,2}\\/\\d{1,2}(\\/\\d{2,4})?$"
                    },
                    "edited": {
                        "description": "If applicable, date the post was last updated",
                        "type": "string",
                        "pattern": "^\\d{1,2}\\/\\d{1,2}(\\/\\d{2,4})?$"
                    },
                    "flags": {
                        "description": "Flags for the blog",
                        "type": "object",
                        "properties": {
                            "formal": {
                                "description": "Is the post overly formal",
                                "type": "boolean"
                            },
                            "rant": {
                                "description": "self-explanitory, im writing these for myself why do i write a description for each one even if the description is basically exacly the same as the name of the goddamn thing in the first place",
                                "type": "boolean"
                            }
                        }
                    },
                    "size": {
                        "description": "Size of the file",
                        "type": "string",
                        "pattern": "^\\d{1,3}(\\.\\d)?[BKM][B ]$"
                    }
                }
            }
        }
    }
}