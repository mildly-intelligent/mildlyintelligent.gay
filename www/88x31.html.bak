<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/x-icon" href="https://static.mildlyintelligent.gay/images/favicon.ico?hash=6bef2f8bf6a8527a1e29363d8a7edbb9">
    <link rel="stylesheet" href="https://static.mildlyintelligent.gay/styles/main.css?hash=24bd48aadf50fab33bf752f7651d5712">
    <script src="https://static.mildlyintelligent.gay/scripts/include.js?hash=a3c9e446fedf05772667a9e45f236ea2"></script>
    <script src="https://static.mildlyintelligent.gay/scripts/header.js?hash=980302db41fc3200216796e37cbcbae1"></script>
    <script src="https://static.mildlyintelligent.gay/scripts/88x31.js?hash=dcbfd378862cc56d7b5499d7498b4cc7"></script>
    <style>
      ._88x31 {
        padding: 1px 3px;
      }
    </style>
  </head>
  <body>
    <div class="col">
      <div id="include-file-header"></div>
      <script>add_header("https://static.mildlyintelligent.gay/templates/header.shtml");</script>

      <div class="row">
        <fieldset class="tui-window">
          <legend class="tui-title" style="width:max-content">icat ~/88x31/webrings/*</legend>
          <div>
            <script src="https://transring.neocities.org/ring.js"></script>

            <div style="scale:0.5;height:20px;width:0;">
              <map name="noaicode">
              <area href="https://baccyflap.com/noai" target="_blank" shape="poly" coords="55,0,255,0,255,13,294,13,294,51,55,51" alt="no ai webring" title="no ai webring">
              <area href="https://baccyflap.com/noai/?prv&s=mya" target="_top" shape="poly" coords="1,25,52,0,52,51" alt="previous" title="previous">
              <area href="https://baccyflap.com/noai/?rnd" target="_top" shape="rect" coords="258,1,294,10" alt="random" title="random">
              <area href="https://baccyflap.com/noai/?nxt&s=mya" target="_top" shape="poly" coords="349,25,297,0,297,51" alt="next" title="next">
              </map>
              <img usemap="#noaicode" src="https://baccyflap.com/noai/codewidget-d.gif" alt="a long dark bar with a background of blurry Python code, with the text AI? AIN'T INTERESTED! / THE NO AI WEBRING over it. In the top right corner is a button labeled RANDOM and to either side of the bar are rectangles labeled PREV and NEXT">
            </div>
          </div>
        </fieldset>

        <div class="col">
          <fieldset class="tui-window">
            <legend class="tui-title">icat ~/88x31/friends/*</legend>
            <div>
              <!-- PLEASE MAKE THIS ON YOUR SITE -->
              <a href="https://hacklub.com/"><img class="_88x31" src="https://static.mildlyintelligent.gay/images/88x31/elles_site.png?hash=a1b5c54f66dd5a66958e63977b5218a6"></a>
            </div>
         </fieldset>
         <fieldset class="tui-window">
            <legend class="tui-title">icat ~/88x31/*.*</legend>
            <div id="88x31-list">
              <span class="comment"># If the buttons aren't showing up try reloading the page, sorry about that</span>
            </div>
          </fieldset>
        </div>
      </div>
    </div>
  </body>
</html>